# Copy this file to .env and fill in your own values. Never commit .env.
# Secrets are left empty on purpose. Non-secret settings have values.

# PostgreSQL (Phase 2). Put your own password between the ":" and the "@".
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:@127.0.0.1:5432/cyberguard
# Used only by pytest. Must point to a database whose name ends with _test.
TEST_DATABASE_URL=postgresql://postgres:@127.0.0.1:5432/cyberguard_test

# Logging (Phase 2). Allowed: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Upload limit (Phase 3)
MAX_UPLOAD_MB=5

# Google Gemini (Phase 9). Proposed model name, to be verified in Phase 9.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20

# Telegram (Phase 10)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Health checker (Phase 10)
HEALTH_URL=http://127.0.0.1:8000/health
HEALTH_INTERVAL_SECONDS=60
